# UniSphere Environment Configuration
PORT=8080
NODE_ENV=development
JWT_SECRET=unisphere-super-secret-jwt-token-key-2026

# PostgreSQL Connection String (Format: postgres://username:password@localhost:5432/unisphere)
# Leave empty to fallback to local SQLite (unisphere.sqlite)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unisphere

# Redis Connection URL (Optional)
REDIS_URL=redis://localhost:6379

# Google & Microsoft OAuth Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=your-microsoft-client-id-guid
